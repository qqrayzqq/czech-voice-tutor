TELEGRAM_BOT_TOKEN=
# Telegram user_id, через запятую. Только личные чаты.
ALLOWED_USER_IDS=
OPENROUTER_API_KEY=
DATABASE_URL=
MINI_APP_URL=
# Optional for polling; configure before enabling the Telegram webhook.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_MAX_CONNECTIONS=4

# Optional: enables voice input through Soniox.
SONIOX_API_KEY=

# Uses OPENROUTER_API_KEY. User profiles default to voice; false is a global text fallback.
TTS_ENABLED=true
TTS_VOICE=nadine
